-- Usually, the latest GHC requires a few allow-newer's
-- for some time after the release. This project file is meant to host these.
-- The file is supposed to be included in the main project files used for
-- Cabal development:
--   - cabal.project (day-to-day development),
--   - cabal.validate.project (Cabal CI),
-- Commented out below are the usual suspects. Feel free to add more.

-- NOTE: don't forget to update the compiler version in the conditional
-- when upgrading to a newer GHC
if impl(ghc >= 10)
    allow-newer:
        aeson:template-haskell
      , aeson:time
      , assoc:base
      , async:base
      , bifunctors:template-haskell
      , Cabal-3.12.1.0:containers
      , Cabal-3.12.1.0:time
      , Cabal-syntax-3.12.1.0:containers
      , Cabal-syntax-3.12.1.0:time
      , cabal-testsuite:containers
      , data-fix:base
      , hackage-security:base
      , hackage-security:ghc-prim
      , hackage-security:template-haskell
      , hackage-security:time
      , hsc2hs:base
      , HTTP:base
      , HTTP:time
      , indexed-traversable:base
      , indexed-traversable-instances:base
      , integer-conversion:base
      , integer-logarithms:base
      , nothunks:containers
      , nothunks:time
      , OneTuple:base
      , parallel:base
      , primitive:base
      , scientific:base
      , scientific:template-haskell
      , semialign:base
      , splitmix:base
      , tagged:template-haskell
      , tasty-bench:ghc-prim
      , text-iso8601:time
      , text-short:base
      , text-short:ghc-prim
      , text-short:template-haskell
      , th-abstraction:template-haskell
      , th-compat:template-haskell
      , these:base
      , time-compat:base
      , time-compat:time
      , tree-diff:base
      , unordered-containers:template-haskell
      , uuid-types:template-haskell
      , vector:base
      , vector-stream:base
      , vector-stream:ghc-prim
      , vector-th-unbox:template-haskell
      , zinza:base
      , zlib:base
    source-repository-package
        type: git
        location: https://github.com/typechecker/hashable.git
        tag: fb9badd5ae735c7be180242bdde7ea0f5a230cfd
    source-repository-package
        type: git
        location: https://github.com/typechecker/vector-th-unbox.git
        tag: 39832ca661766155d4dae6faa1275cdcabe516b8

