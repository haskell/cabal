-- Usually, the latest GHC requires a few allow-newer's for some time after the
-- release. This project file is meant to host these.  For examples, see this
-- file's history.
if impl(ghc >= 10)
    allow-newer:
        aeson:template-haskell
      , aeson:time
      , assoc:base
      , async:base
      , bifunctors:template-haskell
      , data-fix:base
      , hackage-security:base
      , hackage-security:ghc-prim
      , hackage-security:template-haskell
      , hackage-security:time
      , hashable:base
      , hashable:containers
      , hashable:ghc-bignum
      , hsc2hs:base
      , HTTP:base
      , HTTP:time
      , indexed-traversable:base
      , indexed-traversable-instances:base
      , integer-conversion:base
      , integer-logarithms:base
      , nothunks:containers
      , nothunks:time
      , OneTuple:base
      , parallel:base
      , primitive:base
      , scientific:base
      , scientific:template-haskell
      , semialign:base
      , splitmix:base
      , tagged:template-haskell
      , tasty-bench:ghc-prim
      , text-iso8601:time
      , text-short:base
      , text-short:ghc-prim
      , text-short:template-haskell
      , th-abstraction:template-haskell
      , th-compat:template-haskell
      , these:base
      , time-compat:base
      , time-compat:time
      , tree-diff:base
      , unordered-containers:template-haskell
      , uuid-types:template-haskell
      , vector:base
      , vector-stream:base
      , vector-stream:ghc-prim
      , vector-th-unbox:base
      , vector-th-unbox:template-haskell
      , zinza:base
      , zlib:base
    -- Earlier versions of hashable have the ghc-bignum dependency.
    constraints: hashable < 1.5.1.0

