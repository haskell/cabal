BS.concat
  [
    "its-a-new-field:\n",
    "  , value\n",
    "  , value on another line,\n",
    "\n",
    "cabal-version: 3.0\n",
    "name: simple\n",
    "version: 1.0\n",
    "\n",
    "library\n",
    "         -- before\n",
    "\n",
    "    -- within\n",
    "\n",
    "\n",
    "  build-depends\n",
    "               :\n",
    "\n",
    "\n",
    "    -- after\n",
    "\n",
    "\n",
    "    base > 4.8\n",
    "\n",
    "\n",
    "library namedLibrary\n",
    "  build-depends\n",
    "               :\n",
    "\n",
    "\n",
    "\n",
    "                 base <= 5\n"]
