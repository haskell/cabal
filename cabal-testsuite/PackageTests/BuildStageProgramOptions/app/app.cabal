cabal-version:      2.4
name:               app
version:            0.1.0.0
build-type:         Simple

executable app
  main-is:            Main.hs
  -- 'mylib' is a library dependency of this executable, while 'tool' is a
  -- build-tool dependency that itself depends on 'mylib'. Under
  -- cross-compilation, 'tool' and its copy of 'mylib' are built for the build
  -- stage, with the build-stage program options, and this executable and its
  -- copy of 'mylib' for the host stage, with the host-stage ones.
  build-depends:      base, mylib
  build-tool-depends: tool:tool
  default-language:   Haskell2010
