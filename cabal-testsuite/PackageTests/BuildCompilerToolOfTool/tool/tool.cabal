cabal-version:      2.4
name:               tool
version:            0.1.0.0
build-type:         Custom

custom-setup
  setup-depends:
      base
    , Cabal >= 2.0

executable tool
  main-is:            Main.hs
  -- 'tool' is a build tool of 'app', so it is built at the build stage. Its
  -- own build tool 'gen' and its custom Setup.hs are then also at the build
  -- stage: there is no earlier stage to drop to.
  build-depends:      base
  build-tool-depends: gen:gen
  default-language:   Haskell2010
