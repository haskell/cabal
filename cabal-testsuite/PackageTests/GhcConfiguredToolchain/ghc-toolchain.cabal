cabal-version: 2.2
name: ghc-toolchain
version: 0.1
build-type: Simple

library
  exposed-modules: Lib
  hs-source-dirs: src
  build-depends: base
  default-language: Haskell2010
  c-sources: cbits/clib.c

executable ghc-toolchain-exe
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base, ghc-toolchain
  default-language: Haskell2010
