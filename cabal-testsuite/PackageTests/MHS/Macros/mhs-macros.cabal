cabal-version:   3.0
name:            mhs-macros
version:         1.0
build-type:      Simple
license:         BSD-3-Clause
synopsis:        The version macros of cabal_macros.h with MicroHs

library
    exposed-modules:  Versions
    build-depends:    base >=4.14 && <5, bytestring >=0.11
    hs-source-dirs:   src
    default-language: Haskell2010

executable mhs-macros
    main-is:          Main.hs
    build-depends:    base, mhs-macros
    hs-source-dirs:   app
    default-language: Haskell2010
