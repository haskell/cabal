cabal-version:   3.0
name:            mhs-csources
version:         1.0
build-type:      Simple
license:         BSD-3-Clause
synopsis:        C sources with MicroHs

library
    exposed-modules:  Twice
    c-sources:        cbits/twice.c
    include-dirs:     include
    install-includes: twice.h
    build-depends:    base
    hs-source-dirs:   src
    default-language: Haskell2010

executable mhs-csources
    main-is:          Main.hs
    c-sources:        app/offset.c
    include-dirs:     app
    cc-options:       -DOFFSET=7
    build-depends:    base, mhs-cdep, mhs-csources
    hs-source-dirs:   app
    default-language: Haskell2010
