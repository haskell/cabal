cabal-version: 2.2
name:          Cabal-QuickCheck
version:       3.19.0.0
synopsis:      QuickCheck instances for types in Cabal
category:      Testing
build-type:    Simple
description:
  Provides QuickCheck Arbitrary instances for some types in Cabal

library
  default-language: GHC2021
  hs-source-dirs:   src
  ghc-options:      -Wall
  build-depends:
    , base
    , bytestring
    , Cabal         ^>=3.19.0.0
    , Cabal-syntax  ^>=3.19.0.0
    , QuickCheck    >= 2.13.2 && < 2.18

  exposed-modules:
    Test.QuickCheck.GenericArbitrary
    Test.QuickCheck.Instances.Cabal

test-suite spec-version-check
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: tests
  main-is: SpecVersion.hs
  autogen-modules: Paths_Cabal_QuickCheck
  other-modules: Paths_Cabal_QuickCheck
  build-depends:
    , base         >= 4.17 && < 5
    , Cabal-syntax ^>= 3.19
