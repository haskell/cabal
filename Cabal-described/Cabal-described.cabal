cabal-version: 2.2
name:          Cabal-described
version:       3.19.0.0
synopsis:      Described functionality for types in Cabal
category:      Testing, Parsec
description:   Provides rere bindings
build-type:    Simple

library
  default-language: GHC2021
  hs-source-dirs:   src
  ghc-options:      -Wall
  build-depends:
    , base
    , Cabal             ^>=3.19.0.0
    , Cabal-syntax      ^>=3.19.0.0
    , containers
    , pretty
    , QuickCheck
    , rere              >=0.1 && <0.3
    , tasty             <1.6
    , tasty-quickcheck  <0.12

  exposed-modules:
    Distribution.Described
    Distribution.Utils.CharSet
    Distribution.Utils.GrammarRegex

test-suite spec-version-check
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: tests
  main-is: SpecVersion.hs
  autogen-modules: Paths_Cabal_described
  other-modules: Paths_Cabal_described
  build-depends:
    , base         >= 4.17 && < 5
    , Cabal-syntax ^>= 3.19
