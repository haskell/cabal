cabal-version: 2.2
name:          Cabal-tree-diff
version:       3.19.0.0
synopsis:      QuickCheck instances for types in Cabal
category:      Testing
description:   Provides tree-diff ToExpr instances for some types in Cabal

library
  default-language: GHC2021
  hs-source-dirs:   src
  ghc-options:      -Wall
  build-depends:
    , base
    , Cabal-syntax  ^>=3.19.0.0
    , Cabal         ^>=3.19.0.0
    , tree-diff     ^>=0.1 || ^>=0.2 || ^>=0.3

  exposed-modules:  Data.TreeDiff.Instances.Cabal
  other-modules:
    Data.TreeDiff.Instances.CabalLanguage
    Data.TreeDiff.Instances.CabalSPDX
    Data.TreeDiff.Instances.CabalVersion

test-suite spec-version-check
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: tests
  main-is: SpecVersion.hs
  autogen-modules: Paths_Cabal_tree_diff
  other-modules: Paths_Cabal_tree_diff
  build-depends:
    , base         >= 4.17 && < 5
    , Cabal-syntax ^>= 3.19
